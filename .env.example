# Copy to `.env` (gitignored) in the repo root and fill in what you use.
# Real shell environment variables always win over this file.

# ── 1. Agent backend ────────────────────────────────────────────────────────
# claude_p (default): agents run through the Claude Code CLI (`claude -p`),
#                     billed to whatever account you are logged into.
# api:                agents run through any LLM provider via LiteLLM, using the
#                     API key(s) below. No Claude Code install needed.
# tmux:               Claude Code in interactive tmux panes (advanced).
FRAUD_INV_EXEC_BACKEND=api

# ── 2. Provider keys (api backend; set only the ones you use) ──────────────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# Local / self-hosted OpenAI-compatible server (Ollama, vLLM, LM Studio):
# FRAUD_INV_API_BASE=http://localhost:11434

# ── 3. Model choice (api backend) ──────────────────────────────────────────
# Any LiteLLM model string ("provider/model"). With nothing set, the built-in
# per-step split is used (Sonnet for tool-heavy steps, Opus for reasoning gates).
# One model for every step:
# FRAUD_INV_API_MODEL=anthropic/claude-sonnet-5
# Or per step (step names: investigator_discover, investigator, counsel_build,
# counsel_first_chair_review, counsel_rebuttal, counsel_disposition, defense,
# foreclosure_check, legal_adv_response, rebuttal_investigator, case_writer, triage):
# FRAUD_INV_API_MODEL_DEFENSE=openai/gpt-5
# Forward each step's effort level as `reasoning_effort` (only if your provider accepts it):
# FRAUD_INV_API_REASONING_EFFORT=1
# Cheap smoke-test profile (fewer, lighter calls):
# FRAUD_INV_PROFILE=draft

# ── 4. Data (optional) ─────────────────────────────────────────────────────
# Tools read, in order: a local file under data/processed/, your own bucket (if an
# rclone remote is configured), then the public dataset, queried in place (only the
# rows a query needs travel; nothing to download). Override the public dataset:
# NP_DATA_URL=hf://datasets/<owner>/needlepoint-data   # or any https mirror; "" = off
# The Medicaid file (about 3 GB) downloads once to data/raw/medicaid/ the first time a case
# needs it. Hugging Face slows anonymous reads under load; a free read token raises the limit
# (huggingface.co/settings/tokens):
# HF_TOKEN=
# Download a year instead, for offline use:  python3 needlepoint.py fetch --year 2024
# Your own S3-compatible bucket (rclone remote holding the credentials):
# NP_R2_REMOTE=r2
# NP_R2_BUCKET=needlepoint-data
# NP_R2_DISABLE=1   # local files only (calibration runs set this)

# ── 5. Optional services ───────────────────────────────────────────────────
# CourtListener (case-law / docket lookups). Free token: courtlistener.com/profile/apis
# COURTLISTENER_TOKEN=
