#!/usr/bin/env bash
# Pre-commit hook: enforce drift guards so curated state never changes silently.
#
#  (1) gold_set guard: any commit touching data/extracted/gold_set.jsonl MUST also stage
#      docs/GOLD_SET.md (a dated changelog entry).  See docs/GOLD_SET.md §0.
#  (2) pipeline guard: any commit touching a pipeline file MUST also stage
#      fraudlib/pipeline_contract.yaml AND docs/WALK_FORWARD_PIPELINE.md.  See that doc §0.
#  (4) triage guard: any commit touching the Stage-3 triage agent/prompt/schema (or a
#      deprecated rerank/v3 artifact) MUST keep Stage 3 resolving to the canonical triage
#      agent and free of deprecated references (scripts/verify_triage_contract.py).
#  (5) schematic guard: any commit changing the overall-pipeline SHAPE — agent drivers (the
#      stages), the orchestrator, agent schemas, or the walk-forward runners — MUST also
#      stage docs/PIPELINE_SCHEMATIC.md so the architecture diagram never silently drifts.
#  (6) script-registry guard: every script under scripts/ MUST be registered in
#      scripts/REGISTRY.yaml (status: canonical|library|scrape|deprecated).
#  (7) vocabulary guard: a staged ADDED line MUST NOT introduce a DEPRECATED term
#      (source of truth: scripts/REGISTRY.yaml `vocabulary:` — e.g. "v9 labels" -> gold_set,
#      "rules_v3 agent filter" -> floor_0.50).  See scripts/verify_vocabulary.py.
#
# Install (no git-config change):  ln -s ../../scripts/git-hooks/pre-commit .git/hooks/pre-commit
#   (or, reproducibly:  make install-hooks)
# Intentional exceptions:  ALLOW_GOLDSET_DRIFT=1 / ALLOW_PIPELINE_DRIFT=1 / ALLOW_GUI_DRIFT=1 / ALLOW_TRIAGE_DRIFT=1 / ALLOW_SCHEMATIC_DRIFT=1 / ALLOW_REGISTRY_DRIFT=1 / ALLOW_VOCAB_DRIFT=1 git commit ...
set -euo pipefail

staged="$(git diff --cached --name-only --diff-filter=ACM)"

# ---- (1) gold_set guard ---------------------------------------------------
GOLDSET='data/extracted/gold_set.jsonl'
GOLDSET_DOC='docs/GOLD_SET.md'

goldset_staged="$(printf '%s\n' "$staged" | grep -Fx "$GOLDSET" || true)"
if [ -n "$goldset_staged" ] && [ "${ALLOW_GOLDSET_DRIFT:-0}" != "1" ]; then
  goldset_doc_staged="$(printf '%s\n' "$staged" | grep -Fx "$GOLDSET_DOC" || true)"
  if [ -z "$goldset_doc_staged" ]; then
    {
      echo ""
      echo "❌ pre-commit BLOCKED: gold_set changed without updating its changelog:"
      echo "      $GOLDSET"
      echo ""
      echo "   → also update + stage:  $GOLDSET_DOC"
      echo "     Add a dated '## Changelog' entry: what changed, why, row + unique-NPI counts,"
      echo "     and the backup path. See $GOLDSET_DOC §0."
      echo "   Intentional exception:  ALLOW_GOLDSET_DRIFT=1 git commit ..."
      echo ""
    } >&2
    exit 1
  fi
fi

# ---- (4) triage contract guard --------------------------------------------
# Stage 3 must always resolve to the canonical triage agent (prompts/triage.md +
# agents/triage.py + TriageItem/TriageOutput); deprecated rerank/v3 artifacts must live
# only under legacy/ and never be referenced by live code. verify_triage_contract.py is
# stdlib-only (text + ast), safe + fast here.
triage_re='^(fraud-investigator-v2/src/fraud_investigator/agents/(triage|rerank)\.py|fraud-investigator-v2/src/fraud_investigator/prompts/(triage|rerank)\.md|fraud-investigator-v2/src/fraud_investigator/pipeline_schemas\.py|fraud-investigator-v2/src/fraud_investigator/event_sink\.py|scripts/orchestrate_pipeline\.py|prompts/agent_triage_2023_v3\.md|scripts/experiments/prepare_agent_triage_batches\.py)$'
triage_hits="$(printf '%s\n' "$staged" | grep -E "$triage_re" || true)"
if [ -n "$triage_hits" ] && [ "${ALLOW_TRIAGE_DRIFT:-0}" != "1" ]; then
  if ! python3 scripts/verify_triage_contract.py >&2; then
    {
      echo ""
      echo "❌ pre-commit BLOCKED: triage contract drift — Stage 3 no longer resolves to the canonical triage agent."
      echo "   Triggered by:"
      printf '%s\n' "$triage_hits" | sed 's/^/      /'
      echo "   Fix per the messages above (keep prompts/triage.md + agents/triage.py canonical; deprecated artifacts under legacy/ only)."
      echo "   Intentional exception:  ALLOW_TRIAGE_DRIFT=1 git commit ..."
      echo ""
    } >&2
    exit 1
  fi
fi

# ---- (5) pipeline-schematic guard -----------------------------------------
# docs/PIPELINE_SCHEMATIC.md is the canonical end-to-end architecture doc. Any change to the
# pipeline's SHAPE — agent drivers (the stages), the orchestrator, the agent schemas, or the
# walk-forward runners — MUST also stage the schematic so it never silently drifts (it once
# pointed at deleted files). Bypass: ALLOW_SCHEMATIC_DRIFT=1.
schematic_re='^(scripts/orchestrate_pipeline\.py|fraud-investigator-v2/src/fraud_investigator/agents/[^/]+\.py|fraud-investigator-v2/src/fraud_investigator/pipeline_schemas\.py|scripts/experiments/walk_forward_v4\.py|scripts/experiments/run_tier1_combined\.py)$'
SCHEMATIC='docs/PIPELINE_SCHEMATIC.md'
schematic_hits="$(printf '%s\n' "$staged" | grep -E "$schematic_re" || true)"
if [ -n "$schematic_hits" ] && [ "${ALLOW_SCHEMATIC_DRIFT:-0}" != "1" ]; then
  schematic_staged="$(printf '%s\n' "$staged" | grep -Fx "$SCHEMATIC" || true)"
  if [ -z "$schematic_staged" ]; then
    {
      echo ""
      echo "❌ pre-commit BLOCKED: pipeline shape changed without updating the schematic:"
      printf '%s\n' "$schematic_hits" | sed 's/^/      /'
      echo ""
      echo "   → also update + stage:  $SCHEMATIC"
      echo "     Reflect the changed stage / agent / data-flow in the end-to-end diagram + component table."
      echo "   Intentional exception:  ALLOW_SCHEMATIC_DRIFT=1 git commit ..."
      echo ""
    } >&2
    exit 1
  fi
fi

# ---- (6) script-registry guard ---------------------------------------------
# scripts/REGISTRY.yaml is the source of truth for which scripts are canonical
# vs library vs scrape. Any ADDED/MODIFIED script under scripts/ must be
# registered, so stale one-offs can never silently accumulate again
# (2026-06-09 cleanup deleted 113 unregistered one-offs). Bypass: ALLOW_REGISTRY_DRIFT=1.
REGISTRY='scripts/REGISTRY.yaml'
if [ "${ALLOW_REGISTRY_DRIFT:-0}" != "1" ] && [ -f "$REGISTRY" ]; then
  script_hits="$(printf '%s\n' "$staged" | grep -E '^scripts/.*\.(py|sh)$' || true)"
  unregistered=""
  for s in $script_hits; do
    grep -qF "\"$s\"" "$REGISTRY" || unregistered="$unregistered$s"$'\n'
  done
  if [ -n "$unregistered" ]; then
    {
      echo ""
      echo "❌ pre-commit BLOCKED: script(s) not in $REGISTRY:"
      printf '%s' "$unregistered" | sed 's/^/      /'
      echo ""
      echo "   → add an entry {status: canonical|library|scrape|deprecated, role: \"...\"} + stage $REGISTRY"
      echo "   Intentional exception:  ALLOW_REGISTRY_DRIFT=1 git commit ..."
      echo ""
    } >&2
    exit 1
  fi
fi

# ---- (7) vocabulary drift guard -------------------------------------------
# Block NEWLY-ADDED deprecated terms (gold_set vs "v9 labels", floor_0.50 vs
# "rules_v3 agent filter", NeedlePoint vs Streamlit, Corpus Curator vs
# doj_api_ingest). Source of truth: scripts/REGISTRY.yaml `vocabulary:`. Scans
# only ADDED diff lines, so existing legacy mentions never block. Bypass:
# ALLOW_VOCAB_DRIFT=1.
if [ "${ALLOW_VOCAB_DRIFT:-0}" != "1" ]; then
  if ! python3 scripts/verify_vocabulary.py >&2; then
    {
      echo ""
      echo "❌ pre-commit BLOCKED: a staged line introduces a DEPRECATED term."
      echo "   → use the canonical term (see scripts/REGISTRY.yaml 'vocabulary:')."
      echo "   Intentional exception (legit historical mention):  ALLOW_VOCAB_DRIFT=1 git commit ..."
      echo ""
    } >&2
    exit 1
  fi
fi

# ---- (2) pipeline guard ---------------------------------------------------
if [ "${ALLOW_PIPELINE_DRIFT:-0}" = "1" ]; then
  echo "pre-commit: ALLOW_PIPELINE_DRIFT=1 set — skipping pipeline/doc sync check." >&2
  exit 0
fi

# Pipeline files whose behavior the contract + doc describe.
pipeline_re='^(scripts/experiments/walk_forward_v4\.py|scripts/experiments/run_tier1_combined\.py|scripts/experiments/discover_multisource_rules_v2\.py|scripts/compute_hcpcs_rich_features\.py|scripts/experiments/build_hcpcs_centrality_fast\.py|scripts/experiments/pretrain_gnn\.py|fraudlib/ranker/multitask\.py|fraudlib/ranker/feature_frames\.py|fraudlib/ranker/feature_select\.py|fraudlib/ranker/gnn\.py|fraudlib/labels/.*\.py|fraudlib/rules/rules_v3\.json)$'

DOC='docs/WALK_FORWARD_PIPELINE.md'
CONTRACT='fraudlib/pipeline_contract.yaml'

pipeline_hits="$(printf '%s\n' "$staged" | grep -E "$pipeline_re" || true)"
[ -z "$pipeline_hits" ] && exit 0   # no pipeline change → nothing to enforce

doc_staged="$(printf '%s\n' "$staged" | grep -Fx "$DOC" || true)"
contract_staged="$(printf '%s\n' "$staged" | grep -Fx "$CONTRACT" || true)"

if [ -n "$doc_staged" ] && [ -n "$contract_staged" ]; then
  exit 0
fi

{
  echo ""
  echo "❌ pre-commit BLOCKED: pipeline file(s) changed without updating the contract/doc:"
  printf '%s\n' "$pipeline_hits" | sed 's/^/      /'
  echo ""
  [ -z "$contract_staged" ] && echo "   → also update + stage:  $CONTRACT"
  [ -z "$doc_staged" ]      && echo "   → also update + stage:  $DOC"
  echo ""
  echo "   Reflect the changed knob's canonical value (+ a history: line) so the"
  echo "   drift guard only flags intended changes. See $DOC §0."
  echo "   Intentional exception:  ALLOW_PIPELINE_DRIFT=1 git commit ..."
  echo ""
} >&2
exit 1
